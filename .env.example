# copy this file to .env and fill in the values

# base url for the site, used by server-side fetch and auth
NEXTAUTH_URL=http://localhost:3000

# secret for signing jwt tokens, generate with `openssl rand -hex 32`
NEXTAUTH_SECRET=

# database url for drizzle/libsql (local file or remote turso/libsql url)
DATABASE_URL=file:./db/ninx.db

# oauth credentials (optional, auth shows "coming soon" until set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# github personal access token for repo showcase (optional)
GITHUB_TOKEN=
