# copy this file to .env and fill in the values

# base url for the site, used by server-side fetch and auth
BETTER_AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# better auth secret for signing tokens, generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# comma-separated list of trusted origins for auth (optional)
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# neon postgres connection string
DATABASE_URL=

# oauth credentials (optional, auth shows "coming soon" until set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# github personal access token for repo showcase (optional)
GITHUB_TOKEN=
