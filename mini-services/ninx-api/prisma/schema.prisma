generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  provider      String   @default("EMAIL")
  providerId    String?
  avatarUrl     String?
  role          String   @default("MEMBER") // MEMBER | OWNER | ADMIN
  banned        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  articles      Article[]
  threads       ForumThread[]
  replies       ForumReply[]

  @@index([email])
  @@index([provider, providerId])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  body        String   @default("")
  coverImage  String?
  tags        String   @default("") // comma-separated; SQLite has no array type
  readingMins Int      @default(1)
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  views       Int      @default(0)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
  @@index([slug])
}

model ForumThread {
  id        String       @id @default(cuid())
  title     String
  body      String       @default("")
  category  String       @default("general")
  pinned    Boolean      @default(false)
  locked    Boolean      @default(false)
  views     Int          @default(0)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   ForumReply[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  @@index([category, createdAt])
  @@index([authorId])
}

model ForumReply {
  id        String     @id @default(cuid())
  body      String
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([threadId, createdAt])
}

model ShopProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  price       Int      @default(0) // store in minor units (cents)
  currency    String   @default("USD")
  image       String?
  status      String   @default("DRAFT") // DRAFT | COMING_SOON | AVAILABLE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
